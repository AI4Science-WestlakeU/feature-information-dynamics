+class PixelImageNetDataset(Dataset):
+    """Raw pixel ImageNet dataset with SR95 whitelist filter + train/val split.
+
+    Images are loaded from an ImageFolder-style root directory,
+    resized/cropped to 256×256, and normalised to [-1, 1].
+
+    Args:
+        root: Path to ImageNet ``train/`` directory (ImageFolder layout).
+        sr95_filter: Restrict to SR95 whitelist classes when True.
+        split: 'train' (90%) or 'val' (10%) of SR95 subset.
+        image_size: Target spatial resolution (default 256).
+        whitelist_path: Path to ``imagenet_sr95_whitelist.json``.
+    """
+
+    _DEFAULT_WHITELIST = (
+        ""
+    )
+
+    def __init__(
+        self,
+        root: str = "",
+        sr95_filter: bool = True,
+        split: str = "train",
+        image_size: int = 256,
+        whitelist_path: str = _DEFAULT_WHITELIST,
+        use_hflip: bool = False,  # H7_HFLIP_FIX
+    ) -> None:
+        self.root = root
+        self.sr95_filter = sr95_filter
+        self.split = split
+        self.image_size = image_size
+
+        _tf_list = [
+            transforms.Resize(image_size),
+            transforms.CenterCrop(image_size),
+        ]
+        if use_hflip:  # H7_HFLIP_FIX
+            _tf_list.append(transforms.RandomHorizontalFlip(p=0.5))
+        _tf_list += [
+            transforms.ToTensor(),
+            transforms.Normalize([0.5, 0.5, 0.5], [0.5, 0.5, 0.5]),
+        ]
+        self.transform = transforms.Compose(_tf_list)
+
+        # Build flat sample list: (img_path, class_id)
+        self._samples, self._class_to_idx = self._scan_root()
+
+        if sr95_filter:
+            sr95_ids = _load_sr95_class_ids(whitelist_path)
+            self.valid_indices = self._filter_and_split(sr95_ids)
+        else:
+            self.valid_indices = list(range(len(self._samples)))
+
+    # ------------------------------------------------------------------
+    # Internal helpers
+    # ------------------------------------------------------------------
+
+    def _scan_root(self):
+        """Enumerate ImageFolder-layout root into flat sample list.
+
+        Returns:
+            samples: list of (img_path: str, class_id: int)
+            class_to_idx: dict[synset_name -> class_id]
+        """
+        root_path = Path(self.root)
+        synsets = sorted(p.name for p in root_path.iterdir() if p.is_dir())
+        class_to_idx = {s: i for i, s in enumerate(synsets)}
+        samples = []
+        for synset in synsets:
+            cls_id = class_to_idx[synset]
+            cls_dir = root_path / synset
+            for img_path in sorted(cls_dir.iterdir()):
+                if img_path.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}:
+                    samples.append((str(img_path), cls_id))
+        return samples, class_to_idx
+
+    def _filter_and_split(self, sr95_ids: set) -> list:
+        """Return sample indices for SR95 classes then apply 9:1 split."""
+        sr95_indices = [
+            i for i, (_, cls_id) in enumerate(self._samples) if cls_id in sr95_ids
+        ]
+        labels = [self._samples[i][1] for i in sr95_indices]
+        return _compute_sr95_split_indices(sr95_indices, labels, self.split)
+
+    # ------------------------------------------------------------------
+    # Dataset interface
+    # ------------------------------------------------------------------
+
+    def __len__(self) -> int:
+        return len(self.valid_indices)
+
+    def __getitem__(self, idx: int):
+        """Return (img_tensor [3, H, W] in [-1,1], label) for index idx."""
+        sample_idx = self.valid_indices[idx]
+        img_path, label = self._samples[sample_idx]
+        img = Image.open(img_path).convert("RGB")
+        img_tensor = self.transform(img)  # [3, image_size, image_size]
+        return img_tensor, label
