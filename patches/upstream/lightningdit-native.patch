+def _load_sr95_class_ids(whitelist_path: str) -> set:
+    """Load SR95 whitelist class IDs from JSON config.
+
+    Args:
+        whitelist_path: Path to imagenet_sr95_whitelist.json.
+
+    Returns:
+        Set of integer class IDs belonging to SR95 subset.
+    """
+    with open(whitelist_path) as f:
+        data = json.load(f)
+    # JSON may be list[int] or dict with 'class_ids' key
+    if isinstance(data, list):
+        class_ids = data
+    else:
+        class_ids = data["class_ids"]
+    return set(int(c) for c in class_ids)
+
+
+def _compute_sr95_split_indices(
+    all_indices: list,
+    all_labels: list,
+    split: str,
+    seed: int = 42,
+) -> list:
+    """Deterministic 9:1 train/val split over SR95 subset.
+
+    Args:
+        all_indices: Global sample indices (into img_to_file_map or ImageFolder).
+        all_labels: Corresponding integer class labels.
+        split: 'train' (90%) or 'val' (10%).
+        seed: Random seed for reproducibility.
+
+    Returns:
+        List of indices for the requested split.
+    """
+    n = len(all_indices)
+    rng = np.random.RandomState(seed)
+    perm = rng.permutation(n)  # [n]
+    n_val = max(1, int(0.1 * n))
+    val_mask = np.zeros(n, dtype=bool)
+    val_mask[perm[:n_val]] = True
+    if split == "val":
+        selected = [all_indices[i] for i in range(n) if val_mask[i]]
+    else:
+        selected = [all_indices[i] for i in range(n) if not val_mask[i]]
+    return selected
 
 
