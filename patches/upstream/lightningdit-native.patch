+    def _detect_label_schema(self) -> str:
+        """Detect label schema by scanning all shards' label tensors.
+
+        Reads only the 'labels' column (not latents) from every shard — fast
+        O(N_shards) reads of small integer tensors (~40KB/shard).
+
+        Returns:
+            'original'   — labels are IN-1K class ids 0..999; global max > 484.
+            'compressed' — labels are SR95 dense index 0..484; global max <= 484.
+
+        Note: Per-shard max is unreliable (shards may be class-sorted so early
+        shards only have low-valued labels).  Full global scan is required.
+        """
+        if not self.files:
+            return "original"
+        global_max = 0
+        for shard in self.files:
+            with safe_open(shard, framework="pt", device="cpu") as f:
+                # Read all labels in one call; labels tensor is tiny (<40 KB/shard).
+                shard_labels = f.get_slice("labels")[:]  # [N_shard]
+            shard_max = int(shard_labels.max().item())
+            if shard_max > global_max:
+                global_max = shard_max
+            if global_max > 484:
+                # Early exit: confirmed original schema, no need to scan rest.
+                break
+        schema = "original" if global_max > 484 else "compressed"
+        print(
+            f"[SR95 filter] detected label schema: {schema}"
+            f" (global_max_label={global_max})"
+        )
+        return schema
+
+    def _filter_sr95(self, sr95_ids: set) -> list:
+        """Return indices of samples whose label is in sr95_ids, then split.
+
+        Supports two label schemas:
+        - 'original':   labels are IN-1K ids 0..999 → filter by sr95_ids whitelist.
+        - 'compressed': labels are SR95 dense index 0..484 → all samples kept
+          (they already belong to the SR95 subset by construction).
+
+        Uses a disk cache keyed by the whitelist hash *and* schema to avoid
+        re-scanning the full shard set on every init.
+        Cache file lives in data_dir alongside latents_stats.pt.
+        """
+        schema = self._detect_label_schema()
+
+        whitelist_hash = hashlib.md5(
+            str(sorted(sr95_ids)).encode()
+        ).hexdigest()[:8]
+        cache_file = os.path.join(
+            self.data_dir,
+            f"sr95_valid_indices_{schema}_{whitelist_hash}.pt",
+        )
+
+        # --- cache hit path ---
+        if os.path.exists(cache_file):
+            cached = torch.load(cache_file, weights_only=False)
+            if "sr95_global" in cached:
+                sr95_global = cached["sr95_global"]
+                print(
+                    f"[SR95 filter] loaded cached {len(sr95_global)} samples"
+                    f" (schema={schema}) from {cache_file}"
+                )
+                dummy_labels = [0] * len(sr95_global)
+                return _compute_sr95_split_indices(
+                    sr95_global, dummy_labels, self.split
+                )
+
+        # --- cache miss: build valid index list ---
+        if schema == "compressed":
+            # All samples already belong to SR95 — no per-sample scan needed.
+            print(
+                f"[SR95 filter] compressed schema: keeping all"
+                f" {len(self._full_map)} samples (no whitelist scan)"
+            )
+            sr95_global = list(self._full_map.keys())
+        else:
+            # 'original' schema: per-sample label check against whitelist.
+            print(
+                f"[SR95 filter] original schema: scanning {len(self._full_map)}"
+                " samples (one-time, saves cache)..."
+            )
+            sr95_global = []
+            for global_idx, info in self._full_map.items():
+                safe_file = info["safe_file"]
+                i = info["idx_in_file"]
+                with safe_open(safe_file, framework="pt", device="cpu") as f:
+                    label_slice = f.get_slice("labels")
+                    label = int(label_slice[i : i + 1].squeeze())
+                if label in sr95_ids:
+                    sr95_global.append(global_idx)
+
+        # Save cache for all subsequent ranks / runs
+        torch.save({"sr95_global": sr95_global}, cache_file)
+        print(
+            f"[SR95 filter] saved cache ({len(sr95_global)} samples,"
+            f" schema={schema}) to {cache_file}"
+        )
+
+        # Deterministic 9:1 split
+        dummy_labels = [0] * len(sr95_global)  # labels not needed for split
+        return _compute_sr95_split_indices(sr95_global, dummy_labels, self.split)
