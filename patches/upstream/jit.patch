+def load_pretrained_for_finetune(
+    model: nn.Module,
+    checkpoint_path: str,
+    pretrained_key: str = "model_ema2",
+    first_conv_key: Optional[str] = None,
+) -> dict:
+    """加载预训练权重到更多通道的 mask/patch-cond 模型，新通道零初始化。
+
+    支持任意通道扩展：3→4ch (Stage 1)、3→7ch (Stage 2)、4→7ch (Stage 1→2 继续训练)。
+    - x_embedder.proj1.weight: [C_out, C_src, kH, kW] → [C_out, C_dst, kH, kW]
+      新通道全零初始化 (torch.zeros_like)，保证新条件输入为 0 时输出不变。
+    - 其余权重直接加载（shape 相同）。
+
+    Args:
+        model: 目标通道数的 JiT 模型实例（JiT，非 Denoiser wrapper）。
+        checkpoint_path: 预训练模型 checkpoint 路径（.pth 文件）。
+        pretrained_key: checkpoint dict 中选取的 state dict key。
+            优先级：model_ema2 > model_ema1 > model（EMA 更稳定，JiT FID 用 EMA）。
+        first_conv_key: proj1 weight 的 state_dict key（剥离前缀后）；None 时自动检测。
+
+    Returns:
+        dict: {
+            "expanded_keys": 经过通道扩展的 key 列表,
+            "loaded_keys": 成功加载的 key 列表,
+            "skipped_keys": shape 不匹配且非 proj1 conv 的 key 列表,
+            "pretrained_key_used": 实际使用的 checkpoint key,
+        }
+
+    Raises:
+        FileNotFoundError: checkpoint 文件不存在。
+        RuntimeError: proj1 weight key 无法检测且未指定。
+    """
+    ckpt_path = Path(checkpoint_path)
+    if not ckpt_path.exists():
+        raise FileNotFoundError(f"Checkpoint not found: {ckpt_path}")
+
+    raw = torch.load(str(ckpt_path), map_location="cpu", weights_only=False)
+
+    # Select state dict with fallback chain: pretrained_key → model_ema1 → model → raw
+    fallback_order = [pretrained_key, "model_ema2", "model_ema1", "model"]
+    # Deduplicate while preserving order
+    seen: set = set()
+    fallback_order = [k for k in fallback_order if not (k in seen or seen.add(k))]
+
+    src_sd = None
+    key_used = None
+    if isinstance(raw, dict):
+        for candidate in fallback_order:
+            if candidate in raw:
+                src_sd = raw[candidate]
+                key_used = candidate
+                print(f"[load_pretrained] Using checkpoint key: '{key_used}'")
+                break
+    if src_sd is None:
+        # raw is already a flat state dict
+        src_sd = raw
+        key_used = "<flat>"
+
+    # Strip common prefixes produced by DDP / Denoiser wrapper.
+    # Use removeprefix (not lstrip) to avoid stripping partial matches.
+    src_sd = {k.removeprefix("module."): v for k, v in src_sd.items()}
+    src_sd = {k.removeprefix("net."): v for k, v in src_sd.items()}
+    src_sd = {k: v for k, v in src_sd.items() if isinstance(v, torch.Tensor)}
+
+    # 自动检测 proj1 weight key
+    if first_conv_key is None:
+        candidates = [k for k in src_sd if "x_embedder.proj1.weight" in k or k == "x_embedder.proj1.weight"]
+        first_conv_key = candidates[0] if candidates else None
+    if first_conv_key is None:
+        sample_keys = list(src_sd.keys())[:8]
+        raise RuntimeError(
+            f"Cannot detect proj1 weight key (searched for 'x_embedder.proj1.weight') "
+            f"in checkpoint after prefix stripping. "
+            f"First 8 keys: {sample_keys}. "
+            f"Pass first_conv_key explicitly or check prefix stripping logic."
+        )
+
+    dst_sd = model.state_dict()
+    new_sd: dict = {}
+    expanded_keys: list = []
+    loaded_keys: list = []
+    skipped_keys: list = []
+
+    for key, dst_val in dst_sd.items():
+        # Strip "net." prefix added by Denoiser wrapper
+        src_key = key.removeprefix("net.")
+
+        if src_key not in src_sd:
+            new_sd[key] = dst_val  # keep current init
+            skipped_keys.append(key)
+            continue
+
+        src_val = src_sd[src_key]
+
+        if src_key == first_conv_key and src_val.shape != dst_val.shape:
+            # Expand Nch → Mch: [C_out, N, kH, kW] → [C_out, M, kH, kW]
+            # New channels (index N..M-1) zero-initialized to preserve pretrained behavior
+            C_out, C_in_src, kH, kW = src_val.shape
+            C_in_dst = dst_val.shape[1]
+            n_new = C_in_dst - C_in_src
+            if n_new <= 0:
+                raise RuntimeError(
+                    f"proj1 dst channels ({C_in_dst}) <= src channels ({C_in_src}); "
+                    f"loading a wider model into a narrower one is not supported."
+                )
+            zero_ch = torch.zeros(C_out, n_new, kH, kW, dtype=src_val.dtype)
+            expanded = torch.cat([src_val, zero_ch], dim=1)  # [C_out, C_in_dst, kH, kW]
+            new_sd[key] = expanded
+            expanded_keys.append(key)
+            print(
+                f"[load_pretrained] Expanded x_embedder.proj1.weight: "
+                f"{list(src_val.shape)} -> {list(expanded.shape)}"
+            )
+        elif src_val.shape == dst_val.shape:
+            new_sd[key] = src_val
+            loaded_keys.append(key)
+        else:
+            new_sd[key] = dst_val  # keep current init on shape mismatch
+            skipped_keys.append(key)
+            print(f"[load_pretrained] Shape mismatch for {src_key}: src={list(src_val.shape)}, dst={list(dst_val.shape)}")
+
+    model.load_state_dict(new_sd, strict=True)
+    print(f"[load_pretrained] key='{key_used}', loaded={len(loaded_keys)}, expanded={len(expanded_keys)}, skipped={len(skipped_keys)}")
+    return {
+        "expanded_keys": expanded_keys,
+        "loaded_keys": loaded_keys,
+        "skipped_keys": skipped_keys,
+        "pretrained_key_used": key_used,
+    }
+
+
+# Backward-compatible alias (Stage 1 callers)
+load_pretrained_3ch_for_mask_finetune = load_pretrained_for_finetune
